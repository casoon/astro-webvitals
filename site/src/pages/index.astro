---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import pages from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
import { readFile } from 'node:fs/promises';
// Real captures, 23 November 2026, headless Chromium.
// dashboard.webp (1400 px) and dashboard-narrow.webp (first page card at 400 px), 0.5.1:
// a build of this site with <WebVitals dashboard /> added to the start page and the
// quickstart, served under its real address; each page loaded and clicked a few times.
// overlay-*.webp, 0.5.0: the debug overlay on a copy of examples/pages/sample.html, a page
// with deliberate gaps, in the demo build (examples/demo/).
// Retake them when the UI changes.
import dashboardNarrow from '../assets/dashboard-narrow.webp?url';
import dashboardShot from '../assets/dashboard.webp?url';
import overlayA11y from '../assets/overlay-accessibility.webp?url';
import overlayVitals from '../assets/overlay-vitals.webp?url';
import Diagram from '../components/Diagram.astro';
import { entryGzip, kB } from '../showcase';

const layout = `---
import { WebVitals } from '@casoon/astro-webvitals';
---
<WebVitals endpoint="/api/analytics/vitals" sampleRate={0.1} />`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = pages.changelog
  ? parseChangelog(await readFile(pages.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    layout="editorial"
    title="Web Vitals from real visits, for Astro."
    lead="One component in your layout measures LCP, CLS, INP, FCP and TTFB in your visitors’ browsers and sends them to an endpoint you own: no third-party script, no account, and nothing collected before consent if you ask for it."
  >
    <Install
      commands={[
        { label: 'pnpm', command: 'pnpm add @casoon/astro-webvitals' },
        { label: 'npm', command: 'npm install @casoon/astro-webvitals' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {pages.version}</Badge>
      <Badge>Astro 7</Badge>
      <Badge tone="accent">your endpoint only</Badge>
    </Badges>
    <Button href={url('demo/')}>Try the live demo</Button>
    <figure slot="output" class="shot">
      <picture>
        <source media="(max-width: 640px)" srcset={dashboardNarrow} width="720" height="940" />
        <img
          src={dashboardShot}
          width="1400"
          height="950"
          alt="Screenshot of the local Web Vitals dashboard: 2 pages, 12 latest metrics, 0 page issues. The card for the start page of this site shows CLS, DOM, FCP, INP, LCP and TTFB, each with its p75 over 3 loads and rated good, and 10 passed page checks; below it the card for the quickstart page."
        />
      </picture>
      <figcaption>
        The local dashboard after a few visits to two pages of this site in one browser: QA data, not field data. The <a class="inline" href={url('demo/')}>live demo</a> shows the overlay, the reports and <a class="inline" href={url('__web-vitals/')}>this dashboard</a> in this site.
      </figcaption>
    </figure>
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Astro sites that want field data',
        body: 'Lab scores tell you how a page loads on one machine. The component reports what your visitors’ browsers measured, page by page.',
      },
      {
        title: 'Teams that keep data in-house',
        body: 'Reports go to a route on your own domain, or nowhere: without an endpoint the Web Vitals are only browser events for the analytics you already run.',
      },
      {
        title: 'Developers checking a page before release',
        body: 'A local dashboard and a development overlay show metrics, page checks and likely accessibility gaps while you build, without sending anything.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '5', label: 'Web Vitals from Google’s web-vitals' },
      { value: '1', label: 'runtime dependency' },
      { value: '0', label: 'requests before consent with consent={false}' },
      { value: kB(entryGzip), label: 'gzip entry script in the demo build' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">From a page load to your endpoint</h2>
    <div class="text">
      <p>
        Consent, Do Not Track or Global Privacy Control and the sample rate are checked in the
        browser on every page load. If one of them says no, no observer is registered and nothing
        is measured. Consent can also be given or withdrawn later, from your consent banner: a
        withdrawal stops recording at once and deletes what was not sent yet.
      </p>
      <p>
        Otherwise the metrics come from Google’s web-vitals library and are sent in batches: one
        report per page, with origin and path but no query string, and a <code>reportId</code>
        that a retry keeps, so your endpoint can drop duplicates.
      </p>
    </div>
    <Diagram name="reporting" format="svg" narrow={{ width: 380, height: 760 }} />
    <div class="links">
      <Button href={url('demo/')}>Try the live demo</Button>
      <Button href={url('docs/guides/endpoint/')} variant="secondary">Reporting to an endpoint</Button>
      <Button href={url('docs/guides/privacy/')} variant="secondary">Privacy and consent</Button>
    </div>
  </section>

  <section class="dev" aria-labelledby="dev-heading">
    <div class="dev-text">
      <h2 id="dev-heading">While you build</h2>
      <p>
        <code>debug</code> opens an overlay on the page: the current Web Vitals, an SEO
        inspection, a small accessibility heuristic and the console. It is a development aid,
        not a WCAG audit, and <code>import.meta.env.DEV</code> keeps it out of production.
      </p>
      <Button href={url('docs/guides/dashboard/')} variant="secondary">Dashboard and overlay</Button>
    </div>
    <div class="dev-shots">
      <img
        src={overlayVitals}
        width="848"
        height="1038"
        loading="lazy"
        alt="Screenshot of the debug overlay, tab Core Vitals: performance score 100 with 5 of 5 metrics measured, LCP 16 ms, CLS 0.000 and INP 40 ms, each rated good."
      />
      <img
        src={overlayA11y}
        width="848"
        height="1038"
        loading="lazy"
        alt="Screenshot of the debug overlay, tab Accessibility, on a sample page with deliberate gaps: 5 issues found in 3 categories, missing alt text (1), missing labels (3) and heading issues (1)."
      />
    </div>
  </section>

  <Quickstart
    lead="Three steps from install to your first reports. The endpoint, the dashboard route and every option are covered in the documentation."
    steps={[
      'Install <code>@casoon/astro-webvitals</code> with one of the lines above.',
      'Add <code>&lt;WebVitals /&gt;</code> once to your shared layout, right before <code>&lt;/body&gt;</code>.',
      'Store the batches in a same-origin route, or listen for the <code>webvitals:metric</code> event.',
    ]}
  >
    <CodeBlock code={layout} lang="astro" title="src/layouts/Layout.astro" label="Layout" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Does this work with a strict Content Security Policy?',
        a: "Yes. With Astro's security.csp, the component's configuration is passed as inert JSON (<script type=\"application/json\">) and all code runs from the bundled module script Astro serves from your own origin, so no 'unsafe-inline' is needed.",
      },
      {
        q: 'What about the debug overlay and console dock — do those need CSP exceptions?',
        a: 'No. The debug overlay and console dock use no inline event handlers; clicks are dispatched from a data-webvitals-action attribute instead of onclick.',
      },
      {
        q: 'Where do the metrics go?',
        a: "Each Web Vital is emitted locally as a webvitals:metric browser event, which you can listen for without an HTTP endpoint. If you pass an endpoint prop, all metrics, navigation timings included, are batched and sent there: with fetch while the page is visible, with sendBeacon when it is hidden.",
      },
      {
        q: 'What does the local dashboard show?',
        a: "It's a static route backed only by the browser's localStorage — no server or database. Every page that renders <WebVitals dashboard /> stores its latest metrics there, with a p75 over its recent loads, and browser-visible page checks split into issues and recommendations. Run sitemap pass opens every page from your sitemap.xml in that tab to fill it in one go; those pages need the component too.",
      },
      {
        q: 'Which Astro versions and metrics are supported?',
        a: "It is built and tested on Astro 7; the peer range also admits Astro 4 to 6. The component reports the Core Web Vitals LCP, CLS and INP, the supporting metrics FCP and TTFB, navigation timings, and optionally Long Tasks and diagnostic attribution.",
      },
    ]}
  />
</Base>

<style>
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .shot figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .inline {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .how,
  .dev {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p,
  .dev-text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .dev {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 48px;
    align-items: center;
  }
  .dev-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .dev-shots img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  @media (max-width: 860px) {
    .dev {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 640px) {
    .dev-shots {
      grid-template-columns: 1fr;
    }
  }
</style>
