---
/**
 * Cards right under the hero, each jumping to a section further down the page (or out, to a
 * doc). For projects with more than one entry point or audience — "what's in it for you,
 * specifically" before the long-form pitch. The solid label pill reuses the Hero `step` pill;
 * the tinted card background reuses the brand/accent-soft tokens Callout already carries.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: {
    label: string;
    title: string;
    body: string;
    href: string;
    tone?: 'accent' | 'brand';
  }[];
  /** Section label above the grid. Omitted: the grid carries no heading of its own. */
  heading?: string;
}

// Paper, ink, accent in turn — the step cards of hypercitations.com. `tone` is kept for
// compatibility but no longer picks the colour.
const TONES = ['paper', 'ink', 'accent'];
const { items, heading } = Astro.props;
---

<nav class="anchor-grid" aria-label={heading ?? t(config.lang).overview}>
  {heading && <p class="cp-label">{heading}</p>}
  <ul>
    {
      items.map((item, i) => (
        <li>
          <a class={TONES[i % TONES.length]} href={item.href}>
            <span class="label">{item.label}</span>
            <h2>{item.title}</h2>
            <p>{item.body}</p>
            <span class="go" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .anchor-grid {
    max-width: var(--max);
    margin: 0 auto;
    padding: 80px 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 4px edge in a lighter shade of the card, as on hypercitations.com's agent steps. */
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    min-height: 260px;
    padding: 20px 20px 64px;
    border: 4px solid #fff;
    border-radius: var(--r-step);
    color: var(--heading);
    transition: transform 0.2s ease;
  }
  a:hover {
    transform: translateY(-3px);
  }
  a.paper {
    background: var(--bg);
  }
  a.ink {
    border-color: #5a5a5a;
    background: #000;
    color: #fff;
  }
  a.accent {
    border-color: var(--accent-edge);
    background: var(--accent-fill);
    color: #fff;
  }
  :global([data-theme='dark']) a.paper {
    border-color: var(--border-strong);
  }
  .label {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 7px;
    background: #fff;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.3),
      inset 0 0.5px 0 rgb(255 255 255 / 0.5);
    color: #000;
    font-size: 14px;
    line-height: 1.6;
  }
  h2 {
    margin: 0;
    color: inherit;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: inherit;
    font-size: 16px;
    line-height: 1.5;
  }
  .go {
    position: absolute;
    left: 20px;
    bottom: 16px;
    font-size: 40px;
    font-weight: 200;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  a:hover .go,
  a:focus-visible .go {
    transform: translateX(4px);
  }
</style>
