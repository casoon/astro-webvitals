---
/** Static badge: version, licence, registry, status. No external badge services. */
interface Props {
  tone?: 'muted' | 'accent' | 'brand';
}

const { tone = 'muted' } = Astro.props;
---

<span class:list={['badge', tone]}><slot /></span>

<style>
  .badge {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }
  .muted {
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
  }
  .brand {
    color: var(--brand);
  }
</style>
