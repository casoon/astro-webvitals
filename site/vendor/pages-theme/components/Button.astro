---
/** Link styled as button. One primary per view. */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['btn', variant]} href={href}><slot /></a>

<style>
  .btn {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.5;
  }
  .primary {
    border: 1px solid var(--heading);
    background: var(--heading);
    color: var(--bg);
  }
  .primary:hover {
    color: var(--bg);
    opacity: 0.88;
  }
  .secondary {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--heading);
  }
  .secondary:hover {
    border-color: var(--border-strong);
    color: var(--heading);
  }
  .quiet {
    padding-inline: 0;
    color: var(--accent);
  }
</style>
