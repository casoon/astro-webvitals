---
/** One showcase example: input next to the output the package produced at build time. */
import { Code } from 'astro:components';
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';
import type { ShowcaseExample } from '../lib/showcase';
import { url } from '../lib/url';

interface Props {
  example: ShowcaseExample;
  /** Heading level of the title; the detail page uses its own h1. */
  headingLevel?: 2 | 3;
  detailLink?: boolean;
}

const { example, headingLevel = 2, detailLink = true } = Astro.props;
const s = t(config.lang);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const outputKind = example.output.kind ?? 'terminal';
---

<section class="example">
  <header>
    <Heading>{example.title}</Heading>
    <span class="file">{example.file}</span>
    {
      detailLink && (
        <a href={url(`showcase/${example.slug}/`)}>
          {s.detail}<span class="visually-hidden">: {example.title}</span> →
        </a>
      )
    }
  </header>
  <div class="grid">
    <div class="input" aria-label={s.input}>
      <Code code={example.input.code} lang={(example.input.lang ?? 'text') as never} theme="css-variables" />
    </div>
    <div class:list={['output', outputKind]} aria-label={s.output}>
      {outputKind === 'terminal' ? <pre tabindex="0" set:html={example.output.html} /> : <Fragment set:html={example.output.html} />}
    </div>
  </div>
  {
    example.tags && example.tags.length > 0 && (
      <ul class="tags">
        {example.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .example {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  h2,
  h3 {
    margin: 0;
    color: var(--heading);
    font-size: 16px;
    font-weight: 600;
  }
  .file {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  header a {
    margin-left: auto;
    font-size: 13.5px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    container-type: inline-size;
  }
  /* Side by side, the output sets the height of the row and a longer input scrolls inside it,
     so a large data set does not stretch the page. Stacked, the input gets a fixed cap. */
  .input {
    min-width: 0;
    height: 0;
    min-height: 100%;
    border-right: 1px solid var(--border);
    background: var(--code-bg);
  }
  .input :global(pre.astro-code) {
    box-sizing: border-box;
    height: 100%;
    max-height: none;
    margin: 0;
    overflow: auto;
    font-size: 12.5px;
  }
  @container (max-width: 579px) {
    .input {
      height: auto;
      min-height: 0;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    .input :global(pre.astro-code) {
      max-height: 24rem;
    }
  }
  .output {
    min-width: 0;
    overflow: auto;
  }
  .output.terminal {
    background: var(--term-bg);
    color: var(--term-text);
  }
  .output.panel {
    padding: 18px;
  }
  .output pre {
    margin: 0;
    padding: 18px;
    overflow: auto;
    font-size: 12.5px;
    line-height: 1.8;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    list-style: none;
  }
  .tags li {
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>
