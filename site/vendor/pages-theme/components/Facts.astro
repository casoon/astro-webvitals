---
/**
 * Verifiable key figures. Real numbers only.
 * `layout="grid"` (default): a tile per fact, the value large. `layout="list"`: one card, a
 * label/value row per fact — for a spec sheet (license, runtime, platforms) rather than a
 * dashboard of numbers.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: { value: string; label: string }[];
  layout?: 'grid' | 'list';
  /**
   * Region label. Default "Key facts" — override on a page that uses `Facts` more than once,
   * so the two regions don't share one accessible name (axe: landmark-unique).
   */
  label?: string;
}

const { items, layout = 'grid', label } = Astro.props;
---

<section class:list={['facts', `is-${layout}`]} aria-label={label ?? t(config.lang).keyFacts}>
  <dl>
    {
      items.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  dl {
    margin: 0;
  }
  /* Sunken frame holding stat panels, after hypercitations.com's "the shift" cards. */
  .is-grid dl {
    display: grid;
    /* Two columns on phones instead of one tall card per fact. */
    grid-template-columns: repeat(auto-fit, minmax(min(200px, calc(50% - 5px)), 1fr));
    gap: 10px;
    padding: 10px;
    border-radius: var(--r-card);
    background: var(--bg-sunken);
  }
  .is-grid div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    min-height: clamp(120px, 30vw, 170px);
    padding: 24px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 2px 0 var(--shadow-hard);
  }
  .is-grid dd {
    margin: auto 0 8px;
    color: var(--heading);
    font-size: clamp(34px, 3.4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .is-grid dt {
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* Spec sheet: one card, a label/value row per fact. */
  .is-list dl {
    max-width: 440px;
    margin-inline: auto;
    padding: 4px 24px;
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: 2px 2px 0 var(--shadow-hard);
  }
  .is-list div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 15px 0;
    border-top: 1px solid var(--border);
  }
  .is-list div:first-child {
    border-top: 0;
  }
  .is-list dt {
    color: var(--muted);
    font-size: 14.5px;
  }
  .is-list dd {
    margin: 0;
    color: var(--heading);
    font-weight: 600;
    text-align: right;
  }
</style>
