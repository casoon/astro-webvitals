---
/** Native <details> accordion, no JS. Entries stay independent (several may be open at once). */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}

const s = t(config.lang);
const { items, heading = s.faqHeading } = Astro.props;
---

<section class="faq">
  <h2>{heading}</h2>
  <div class="list">
    {
      items.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <span class="icon" aria-hidden="true">
              +
            </span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  h2 {
    margin: 0 0 8px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .list {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    color: var(--heading);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent);
  }
  .icon {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  details[open] .icon {
    transform: rotate(45deg);
  }
  details p {
    margin: 0 0 22px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.6;
  }
</style>
