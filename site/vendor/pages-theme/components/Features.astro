---
/**
 * Core points, each backed by something checkable.
 * `layout="numbered"` (default, 3–5 items): a numbered list. `layout="grid"`: a denser catalog
 * for more items — an icon tile per entry (`icon`, a short mono label) instead of the index.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: { title: string; body: string; icon?: string }[];
  heading?: string;
  layout?: 'numbered' | 'grid';
}

const { items, heading = t(config.lang).featuresHeading, layout = 'numbered' } = Astro.props;
---

<section class:list={['features', `is-${layout}`]}>
  <h2 class="cp-label">{heading}</h2>
  <ul>
    {
      items.map((ft, i) => (
        <li>
          {layout === 'numbered' ? (
            <span class="n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          ) : (
            ft.icon && (
              <span class="icon" aria-hidden="true">
                {ft.icon}
              </span>
            )
          )}
          <div>
            <h3>{ft.title}</h3>
            <p>{ft.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features {
    max-width: var(--max);
    margin: 0 auto;
    padding: 80px 24px;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Large light numerals, as on hypercitations.com's agent steps. */
  .is-numbered ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 10px;
  }
  .is-numbered li {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 28px;
    padding: 30px 24px;
    border-radius: var(--r-card);
    background: var(--bg-deep);
  }
  .n {
    margin-top: auto;
    color: var(--heading);
    font-size: 46px;
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  h3 {
    margin: 0 0 8px;
    color: var(--heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.56;
  }

  /* Catalog: cream, ink and accent cards in turn, like the feature grid of hypercitations.com. */
  .is-grid ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 10px;
  }
  .is-grid li {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-height: 240px;
    padding: 30px 24px;
    border-radius: var(--r-card);
    background: var(--bg-deep);
  }
  .is-grid li:nth-child(6n + 1),
  .is-grid li:nth-child(6n + 6) {
    background: #000;
    color: #ccc;
  }
  .is-grid li:nth-child(6n + 2) {
    background: var(--accent-fill);
    color: #fff;
  }
  .is-grid li:nth-child(6n + 1) h3,
  .is-grid li:nth-child(6n + 6) h3,
  .is-grid li:nth-child(6n + 2) h3 {
    color: #fff;
  }
  .is-grid .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }
  .is-grid li:nth-child(6n + 2) .icon {
    background: #fff;
    color: var(--accent-fill);
  }
</style>
