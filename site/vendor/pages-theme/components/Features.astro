---
/** 3–5 core points, each backed by something checkable. */
interface Props {
  items: { title: string; body: string }[];
  heading?: string;
}

const { items, heading = 'What it does' } = Astro.props;
---

<section class="features">
  <h2 class="cp-label">{heading}</h2>
  <ol>
    {
      items.map((ft, i) => (
        <li>
          <span class="n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3>{ft.title}</h3>
            <p>{ft.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .features {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 28px 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 18px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .n {
    padding-top: 3px;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  h3 {
    margin: 0 0 6px;
    color: var(--heading);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
  }
</style>
