---
import config from 'virtual:casoon-pages/config';
import logo from '../assets/casoon-logo.svg';
import logoDark from '../assets/casoon-logo-dark.svg';
import { t } from '../lib/i18n';
import { CASOON_URL, catalogUrl, url } from '../lib/url';

const s = t(config.lang);
const IMPRESSUM = `${CASOON_URL}impressum/`;
const DATENSCHUTZ = `${CASOON_URL}datenschutz/`;

const columns = [
  {
    title: s.footerProject,
    links: [
      ...(config.website ? [{ label: s.website(config.name), href: config.website }] : []),
      { label: s.documentation, href: url('docs/') },
      ...(config.hasShowcase ? [{ label: s.showcase, href: url('showcase/') }] : []),
      ...(config.changelog ? [{ label: s.changelog, href: url('changelog/') }] : []),
    ],
  },
  {
    title: s.footerPackages,
    links: [
      ...(config.repo ? [{ label: 'GitHub', href: `https://github.com/${config.repo}` }] : []),
      ...config.packages,
    ],
  },
  {
    title: 'CASOON',
    links: [
      { label: 'casoon.de', href: CASOON_URL },
      ...(config.catalog
        ? [{ label: s.catalogEntry(config.name), href: catalogUrl(config.lang, config.catalog) }]
        : []),
      // Only a public GitHub project is actually part of the open-source catalog.
      ...(config.repo ? [{ label: s.allProjects, href: catalogUrl(config.lang) }] : []),
    ],
  },
];
---

<footer class="footer">
  <div class="cols">
    <div>
      <a class="logo" href={CASOON_URL}>
        <img class="logo-light" src={logo.src} width="150" height="41" alt="CASOON" />
        <img class="logo-dark" src={logoDark.src} width="150" height="41" alt="CASOON" />
      </a>
      <p>{config.description}</p>
      <p class="by">{s.footerBy} · Jörn Seidel</p>
    </div>
    {
      columns.filter((col) => col.links.length > 0).map((col) => (
        <nav aria-label={col.title}>
          <p class="title">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="bottom">
    <span>{config.license && `${s.license(config.license)} · `}© {new Date().getFullYear()} Jörn Seidel</span>
    <span class="legal">
      <a href={IMPRESSUM}>{s.imprint}</a>
      <a href={DATENSCHUTZ}>{s.privacyPolicy}</a>
    </span>
  </div>
</footer>

<style>
  /* Black footer, as on hypercitations.com, in both themes. */
  .footer {
    --text: #b3b3b3;
    --muted: #b3b3b3;
    --heading: #fff;
    --border: rgb(255 255 255 / 0.12);

    background: #000;
    color: var(--text);
    font-size: 14px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 80px 24px 48px;
  }
  .logo {
    display: inline-block;
    margin-bottom: 14px;
  }
  .logo img {
    display: block;
    width: 120px;
    height: auto;
  }
  .logo-light {
    display: none !important;
  }
  p {
    margin: 0 0 6px;
    max-width: 32ch;
  }
  .by {
    color: var(--muted);
    font-size: 12.5px;
  }
  .title {
    margin-bottom: 16px;
    color: var(--heading);
    font-size: 18px;
    font-weight: 500;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    color: var(--text);
  }
  ul a:hover {
    color: var(--heading);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 16px 24px 40px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .legal a {
    color: var(--muted);
  }
  .legal a:hover {
    color: var(--heading);
  }
</style>
