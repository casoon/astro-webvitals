---
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';
import { url } from '../lib/url';

const s = t(config.lang);
const path = Astro.url.pathname;
const websiteHost = config.website && new URL(config.website).host.replace(/^www\./, '');
const nav = [
  { label: s.docs, href: url('docs/') },
  ...(config.demo ? [{ label: config.demo, href: url('demo/') }] : []),
  ...(config.hasShowcase ? [{ label: s.showcase, href: url('showcase/') }] : []),
  ...(config.changelog ? [{ label: s.changelog, href: url('changelog/') }] : []),
];
---

<header class="header" data-wide={websiteHost || config.demo ? '' : undefined}>
  <div class="inner">
    <a class="home" href={url()}>
      <span class="name">{config.name}</span>
      {config.version && <span class="version">v{config.version}</span>}
    </a>
    <div class="links">
      {
        websiteHost && (
          <a class="website" href={config.website}>
            {websiteHost}
          </a>
        )
      }
      <nav aria-label={s.mainNav}>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="sep" aria-hidden="true"></span>
        {config.repo && <a class="cta" href={`https://github.com/${config.repo}`}>GitHub</a>}
      </nav>
    </div>
    <button class="theme" type="button" data-theme-toggle aria-label={s.darkTheme} aria-pressed="false" hidden>
      <!-- Shows the theme a click switches to: moon while light, sun while dark. -->
      <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<style>
  /* Floating white pill over the page, after hypercitations.com. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 24px 0;
    pointer-events: none;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1000px;
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 10px 0 24px;
    border-radius: 40px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    pointer-events: auto;
  }
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--heading);
  }
  .home:hover {
    color: var(--heading);
  }
  .name {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .version {
    padding: 1px 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .website {
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 13.5px;
    white-space: nowrap;
  }
  .website:hover {
    border-color: var(--accent);
    color: var(--heading);
  }
  .links {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 7px 14px;
    border-radius: 999px;
    color: var(--heading);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--accent);
  }
  nav a[aria-current='page'] {
    color: var(--heading);
    font-weight: 600;
  }
  nav a.cta {
    padding: 8px 18px;
    background: linear-gradient(180deg, var(--accent-top) 0%, var(--accent-fill) 25%, var(--accent-fill) 100%);
    color: #fff;
  }
  .sep {
    width: 1px;
    height: 20px;
    margin: 0 8px;
    background: var(--border);
  }
  .theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    /* Close to the GitHub link, as if it were the last nav entry: 20px gap - 14px. */
    margin-left: -14px;
    border: 0;
    border-radius: 999px;
    background: var(--bg);
    color: var(--heading);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--border-strong);
    color: var(--heading);
  }
  .theme[hidden] {
    display: none;
  }
  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
  /* Narrow screens: name and theme toggle on the first row, the links on a second row that
     stays one line and scrolls sideways when it does not fit — no wrapped labels, nothing cut
     off. A header with a website pill or a demo entry needs the second row earlier. The website
     pill is dropped from that row: it repeats in the footer's "Project" column, and it was the
     single widest entry, pushing GitHub out of view. */
  @media (max-width: 640px) {
    :global(:root) {
      --header-h: 92px;
    }
    .header {
      padding: 8px 8px 0;
    }
    .inner {
      flex-wrap: wrap;
      align-content: center;
      gap: 2px 8px;
      height: var(--header-h);
      padding: 0 16px;
      border-radius: 24px;
    }
    .links {
      flex: 0 0 calc(100% + 32px);
      order: 3;
      gap: 8px;
      margin: 0 -16px;
      /* Room for the focus outline, which the scroll container would clip. */
      padding: 3px 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .website {
      display: none;
    }
    .theme {
      margin-left: auto;
    }
    nav {
      margin-left: 0;
    }
    .sep {
      display: none;
    }
    nav a {
      padding: 7px 8px;
    }
  }
  @media (max-width: 900px) {
    :global(:root:has(.header[data-wide])) {
      --header-h: 92px;
    }
    [data-wide] .inner {
      flex-wrap: wrap;
      align-content: center;
      gap: 2px 8px;
      height: var(--header-h);
      padding: 0 16px;
    }
    [data-wide] .links {
      flex: 0 0 calc(100% + 32px);
      order: 3;
      gap: 8px;
      margin: 0 -16px;
      /* Room for the focus outline, which the scroll container would clip. */
      padding: 3px 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    [data-wide] .website {
      display: none;
    }
    [data-wide] .theme {
      margin-left: auto;
    }
    [data-wide] nav {
      margin-left: 0;
    }
    [data-wide] .sep {
      display: none;
    }
    [data-wide] nav a {
      padding: 7px 8px;
    }
  }
</style>
