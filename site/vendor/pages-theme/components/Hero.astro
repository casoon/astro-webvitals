---
/**
 * Start-page hero in three layouts:
 *   split     — text beside the `output` slot (default)
 *   stack     — centred text, then a band: `source` slot → `command` → `output` slot
 *   editorial — full-width title, lead beside the default slot, `output` slot below
 * `tone="invert"` puts any of them on a dark brand ground.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  layout?: 'split' | 'stack' | 'editorial';
  /** Shown between the `source` and `output` slots of the stack layout, e.g. `astro build`. */
  command?: string;
  tone?: 'plain' | 'invert';
}

const {
  title,
  lead,
  eyebrow = t(config.lang).heroEyebrow,
  layout = 'split',
  command,
  tone = 'plain',
} = Astro.props;
const hasSource = Astro.slots.has('source');
---

<section class:list={['hero', `is-${layout}`, tone === 'invert' && 'invert']}>
  {
    layout === 'split' && (
      <div class="inner">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="lead">{lead}</p>
          <slot />
        </div>
        <div class="output">
          <slot name="output" />
        </div>
      </div>
    )
  }

  {
    layout === 'stack' && (
      <div class="inner">
        <div class="head">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="lead">{lead}</p>
        </div>
        <div class="band">
          {hasSource && (
            <div class="source">
              <slot name="source" />
            </div>
          )}
          {hasSource && command && (
            <p class="step">
              <span class="pill">{command}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </p>
          )}
          <div class="output">
            <slot name="output" />
          </div>
        </div>
        <div class="actions">
          <slot />
        </div>
      </div>
    )
  }

  {
    layout === 'editorial' && (
      <div class="inner">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <div class="row">
          <p class="lead">{lead}</p>
          <div class="actions">
            <slot />
          </div>
        </div>
        <div class="output">
          <slot name="output" />
        </div>
      </div>
    )
  }
</section>

<style>
  .inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 72px 24px 56px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }
  h1 {
    margin: 0 0 18px;
    color: var(--heading);
    font-size: clamp(34px, 4.2vw, 52px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .lead {
    max-width: 44ch;
    margin: 0 0 30px;
    font-size: 18.5px;
    line-height: 1.6;
  }
  .output {
    min-width: 0;
  }

  /* Text gets a little more than half and a slightly smaller title, so a title of about 40
     characters fits on two lines at desktop width; in two equal halves it took three. */
  .is-split .inner {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .is-split .inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 48px;
    }
    .is-split h1 {
      font-size: clamp(36px, 3.4vw, 48px);
    }
  }

  .is-stack .head {
    text-align: center;
  }
  .is-stack .eyebrow {
    display: inline-flex;
  }
  .is-stack .lead {
    max-width: 62ch;
    margin-inline: auto;
  }
  /* Input over output, not beside it: side by side, neither the source nor the file names
     get enough width inside --max — the code is cut off and the names wrap to a second row. */
  .is-stack .band {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .is-stack .source {
    min-width: 0;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0;
  }
  .pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--brand);
    /* The page ground, not white: on the light brand of the dark theme white reaches only 3:1. */
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .arrow {
    rotate: 90deg;
    color: var(--brand);
    font-size: 20px;
    line-height: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .is-stack .actions {
    justify-content: center;
    margin-top: 34px;
  }

  .is-editorial h1 {
    margin-bottom: 36px;
    font-size: clamp(38px, 6.2vw, 74px);
    line-height: 1.02;
  }
  .is-editorial .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }
  /* Lead and actions share the row about evenly; the actions keep the install box's width, so
     the badges go below it instead of squeezing the lead into a narrow column. Both start at the
     top, so the lead follows the title directly however tall the actions are. */
  .is-editorial .lead {
    flex: 1 1 380px;
    margin: 0;
  }
  .is-editorial .actions {
    flex: 0 1 470px;
  }

  /* Dark brand ground. Child components follow through the tokens. */
  .invert {
    --heading: #fff;
    --text: rgb(255 255 255 / 0.78);
    --muted: rgb(255 255 255 / 0.68);
    --border: rgb(255 255 255 / 0.2);
    --border-strong: rgb(255 255 255 / 0.32);
    --surface: rgb(255 255 255 / 0.07);
    --bg-deep: rgb(255 255 255 / 0.1);
    --code-bg: rgb(255 255 255 / 0.07);
    --accent: var(--invert-accent);
    --shadow: none;

    background: var(--invert-bg);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .inner {
      padding: 52px 24px 44px;
    }
    .is-stack .actions {
      margin-top: 26px;
    }
    .is-editorial h1 {
      margin-bottom: 26px;
    }
    .is-editorial .row {
      margin-bottom: 32px;
    }
  }
</style>
