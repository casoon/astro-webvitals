---
/**
 * A grid of things the project plugs into — registries, CI providers, editors. `icon` is a
 * short mono label (an abbreviation, not a logo image: no external badge or icon service, same
 * reasoning as `Badge`). `more`, given, appends a dashed placeholder card.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: { name: string; category: string; icon: string; href?: string }[];
  heading?: string;
  /** Label for a trailing "more coming" placeholder card. Omitted: no placeholder card. */
  more?: string;
}

const { items, heading, more } = Astro.props;
const s = t(config.lang);
---

<section class="integrations" aria-label={heading ?? s.overview}>
  {heading && <p class="title">{heading}</p>}
  <div class="marquee">
    {
      [false, true].map((copy) => (
        <ul aria-hidden={copy ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              {item.href && !copy ? (
                <a href={item.href}>
                  <span class="icon" aria-hidden="true">
                    {item.icon}
                  </span>
                  <span class="name">{item.name}</span>
                  <span class="visually-hidden">{item.category}</span>
                </a>
              ) : (
                <span class="item">
                  <span class="icon" aria-hidden="true">
                    {item.icon}
                  </span>
                  <span class="name">{item.name}</span>
                </span>
              )}
            </li>
          ))}
          {more && (
            <li>
              <span class="item more">
                <span class="name">{more}</span>
              </span>
            </li>
          )}
        </ul>
      ))
    }
  </div>
</section>

<style>
  /* Logo row that drifts sideways, as "Measured across" on hypercitations.com. The list is
     rendered twice; the copy is hidden from assistive tech and not focusable. */
  .integrations {
    padding: 64px 0 80px;
    background: var(--bg-deep);
    text-align: center;
  }
  .title {
    margin: 0 0 32px;
    color: var(--heading);
    font-size: 18px;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10% 90%, transparent);
  }
  ul {
    display: flex;
    flex: none;
    gap: 72px;
    margin: 0;
    padding: 0 72px 0 0;
    list-style: none;
    animation: marquee 25s linear infinite;
  }
  .marquee:hover ul {
    animation-play-state: paused;
  }
  a,
  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  a:hover {
    color: var(--heading);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .name {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .more .name {
    font-weight: 400;
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }
</style>
