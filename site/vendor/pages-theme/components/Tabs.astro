---
/**
 * CSS-only tabs (e.g. Rust / Node / CLI). One named slot per tab id:
 *   <Tabs tabs={[{ id: 'rust', label: 'Rust' }]}><div slot="rust">…</div></Tabs>
 */
interface Props {
  tabs: { id: string; label: string }[];
  label?: string;
}

const { tabs, label = 'Variants' } = Astro.props;
const uid = `tabs-${tabs.map((t) => t.id).join('-')}`;
const panels = await Promise.all(tabs.map((t) => Astro.slots.render(t.id)));
---

<div class="tabs">
  <div class="list" role="radiogroup" aria-label={label}>
    {
      tabs.map((t, i) => (
        <>
          <input
            class="visually-hidden"
            type="radio"
            name={uid}
            id={`${uid}-${i}`}
            value={i}
            checked={i === 0}
          />
          <label for={`${uid}-${i}`}>{t.label}</label>
        </>
      ))
    }
  </div>
  {panels.map((html, i) => <div class="panel" data-i={i} set:html={html} />)}
</div>

<style>
  .list {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid var(--border);
  }
  label {
    margin-bottom: -1px;
    padding: 9px 14px;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 14px;
    cursor: pointer;
  }
  input:checked + label {
    border-bottom-color: var(--accent);
    color: var(--heading);
  }
  input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .panel {
    display: none;
    padding: 18px;
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    background: var(--code-bg);
  }
  .panel[data-i='0'],
  .tabs:has(> .list input[value='1']:checked) > .panel[data-i='1'],
  .tabs:has(> .list input[value='2']:checked) > .panel[data-i='2'],
  .tabs:has(> .list input[value='3']:checked) > .panel[data-i='3'],
  .tabs:has(> .list input[value='4']:checked) > .panel[data-i='4'],
  .tabs:has(> .list input[value='5']:checked) > .panel[data-i='5'] {
    display: block;
  }
  .tabs:has(> .list input:not([value='0']):checked) > .panel[data-i='0'] {
    display: none;
  }
  .panel :global(pre.astro-code) {
    padding: 0;
    border: 0;
    background: none !important;
    font-size: 13.5px;
  }
  .panel :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
