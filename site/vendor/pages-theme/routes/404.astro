---
import Button from '../components/Button.astro';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <div class="page">
    <p class="code">404</p>
    <h1>This page does not exist.</h1>
    <p>The address may be outdated, or the page moved when the docs were restructured.</p>
    <div class="actions">
      <Button href={url()}>Back to the start page</Button>
      <Button href={url('docs/')} variant="secondary">Open the documentation</Button>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  .code {
    margin: 0 0 12px;
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  h1 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
