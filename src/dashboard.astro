---
const title = "Web Vitals dashboard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI Variable", "Segoe UI", Roboto, "Noto Sans", Ubuntu, Cantarell, Arial, sans-serif;
        --canvas: #f4f7fb;
        --surface: #ffffff;
        --surface-raised: #f9fbff;
        --ink: #172033;
        --muted: #62708a;
        --line: #dbe2ee;
        --accent: #2854d8;
        --accent-soft: #e8eeff;
        --good: #18794e;
        --good-soft: #e5f5ec;
        --needs-improvement: #a86200;
        --needs-improvement-soft: #fff1dc;
        --poor: #bd3030;
        --poor-soft: #fde8e8;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --canvas: #111827;
          --surface: #182235;
          --surface-raised: #1e2a40;
          --ink: #edf2ff;
          --muted: #aab6ca;
          --line: #31405c;
          --accent: #9bb3ff;
          --accent-soft: #22366f;
          --good: #72d2a0;
          --good-soft: #183d30;
          --needs-improvement: #ffc067;
          --needs-improvement-soft: #4c3516;
          --poor: #ff9a9a;
          --poor-soft: #542a31;
        }
      }

      * { box-sizing: border-box; }
      body { min-width: 20rem; margin: 0; background: var(--canvas); color: var(--ink); }
      button { font: inherit; }
      .shell { max-width: 76rem; margin: 0 auto; padding: clamp(1.25rem, 4vw, 3.5rem); }
      .masthead { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
      .kicker { display: flex; align-items: center; gap: .5rem; margin: 0 0 .55rem; color: var(--accent); font-size: .72rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
      .signal { width: .55rem; height: .55rem; border-radius: 999px; background: currentColor; box-shadow: 0 0 0 .25rem var(--accent-soft); }
      h1 { max-width: 12ch; margin: 0; font-size: clamp(2.25rem, 6vw, 4.5rem); font-weight: 780; letter-spacing: -.045em; line-height: .98; }
      .intro { max-width: 50rem; margin: .9rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.55; }
      .actions { display: grid; justify-items: end; gap: .75rem; min-width: max-content; }
      .summary { margin: 0; color: var(--muted); font-size: .84rem; font-variant-numeric: tabular-nums; }
      .action-buttons { display: flex; flex-wrap: wrap; justify-content: end; gap: .5rem; }
      .button { border: 1px solid var(--line); border-radius: .55rem; padding: .65rem .8rem; background: var(--surface); color: var(--ink); cursor: pointer; font-size: .84rem; font-weight: 650; transition: border-color .16s ease, background .16s ease, transform .16s ease; }
      .button:hover { border-color: var(--accent); background: var(--accent-soft); }
      .button:active { transform: translateY(1px); }
      .button:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 2px; }
      .button.primary { border-color: var(--accent); background: var(--accent); color: #fff; }
      .button.primary:hover { filter: brightness(1.08); }
      .pass-note { max-width: 19rem; margin: 0; color: var(--muted); font-size: .72rem; line-height: 1.35; text-align: right; }
      main { padding-top: 2rem; }
      .empty { max-width: 42rem; margin: 3.5rem auto; padding: 2rem; border: 1px dashed var(--line); border-radius: .85rem; background: var(--surface-raised); color: var(--muted); line-height: 1.55; text-align: center; }
      .route-list { display: grid; gap: 1rem; }
      .route { border: 1px solid var(--line); border-radius: .85rem; background: var(--surface); overflow: hidden; }
      .route-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; border-bottom: 1px solid var(--line); background: var(--surface-raised); }
      h2 { max-width: 100%; margin: 0; overflow-wrap: anywhere; font-size: .92rem; font-weight: 700; letter-spacing: -.01em; }
      .route-count { flex: 0 0 auto; color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; }
      .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); }
      .metric { display: grid; gap: .35rem; min-height: 8.2rem; padding: 1rem 1.15rem; background: var(--surface); }
      .metric-name { color: var(--muted); font-size: .73rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
      .metric-value { font-size: clamp(1.45rem, 2.5vw, 2rem); font-weight: 760; font-variant-numeric: tabular-nums; letter-spacing: -.04em; line-height: 1; }
      .metric-footer { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: auto; }
      .rating { display: inline-flex; align-items: center; min-height: 1.35rem; border-radius: 999px; padding: .15rem .45rem; background: var(--surface-raised); color: var(--muted); font-size: .7rem; font-weight: 700; text-transform: capitalize; }
      .rating.good { background: var(--good-soft); color: var(--good); }
      .rating.needs-improvement { background: var(--needs-improvement-soft); color: var(--needs-improvement); }
      .rating.poor { background: var(--poor-soft); color: var(--poor); }
      time { color: var(--muted); font-size: .7rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .page-audit { padding: 1rem 1.15rem 1.15rem; border-top: 1px solid var(--line); background: var(--surface-raised); }
      .audit-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
      h3 { margin: 0; font-size: .78rem; font-weight: 780; letter-spacing: .07em; text-transform: uppercase; }
      .audit-summary { margin: 0; color: var(--muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
      .audit-checks { display: flex; flex-wrap: wrap; gap: .4rem; margin: .75rem 0 0; padding: 0; list-style: none; }
      .audit-check { max-width: 100%; border-radius: 999px; padding: .22rem .5rem; background: var(--surface); color: var(--muted); font-size: .7rem; line-height: 1.3; }
      .audit-check.pass { background: var(--good-soft); color: var(--good); }
      .audit-check.issue { background: var(--poor-soft); color: var(--poor); }
      .audit-metadata { margin-top: .85rem; color: var(--muted); font-size: .75rem; }
      .audit-metadata summary { width: fit-content; cursor: pointer; color: var(--ink); font-weight: 700; }
      .metadata-list { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .35rem .75rem; margin: .6rem 0 0; }
      .metadata-list dt { color: var(--muted); font-weight: 650; }
      .metadata-list dd { min-width: 0; margin: 0; overflow: hidden; color: var(--ink); text-overflow: ellipsis; white-space: nowrap; }

      @media (max-width: 42rem) {
        .masthead { flex-direction: column; gap: 1.25rem; }
        .actions { justify-items: start; }
        .action-buttons { justify-content: start; }
        .pass-note { text-align: left; }
        .route-header { align-items: flex-start; flex-direction: column; gap: .25rem; }
        .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .metric { min-height: 7.4rem; padding: .9rem; }
        .page-audit { padding: .9rem; }
        .audit-heading { align-items: flex-start; flex-direction: column; gap: .25rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .button { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <div>
          <p class="kicker"><span class="signal" aria-hidden="true"></span> Browser-local field data</p>
          <h1>{title}</h1>
          <p class="intro">The latest measurements from this browser, grouped by page. This view never sends data anywhere.</p>
        </div>
        <div class="actions">
          <p class="summary" id="summary" aria-live="polite"></p>
          <div class="action-buttons">
            <button class="button primary" id="sitemap-pass" type="button">Run sitemap pass</button>
            <button class="button" id="clear" type="button">Clear local data</button>
          </div>
          <p class="pass-note" id="pass-note">Loads every sitemap page in this tab and returns here. This is local QA data, not representative user data.</p>
        </div>
      </header>
      <main>
        <div id="content" aria-live="polite"></div>
      </main>
    </div>

    <script>
      import {
        clearDashboardMetrics,
        readDashboardMetrics,
        readDashboardPageAudits,
      } from "./client/dashboard-storage";
      import { startSitemapPass } from "./client/sitemap-pass";

      const content = document.querySelector<HTMLDivElement>("#content")!;
      const clear = document.querySelector<HTMLButtonElement>("#clear")!;
      const sitemapPass = document.querySelector<HTMLButtonElement>("#sitemap-pass")!;
      const passNote = document.querySelector<HTMLParagraphElement>("#pass-note")!;
      const summary = document.querySelector<HTMLParagraphElement>("#summary")!;

      type Metric = ReturnType<typeof readDashboardMetrics>[number];
      type PageAudit = ReturnType<typeof readDashboardPageAudits>[number];

      function formatMetric(metric: Metric): string {
        return metric.name === "CLS"
          ? metric.value.toFixed(3)
          : `${Math.round(metric.value)} ms`;
      }

      function renderPageAudit(audit: PageAudit): HTMLElement {
        const auditSection = document.createElement("section");
        auditSection.className = "page-audit";
        const heading = document.createElement("div");
        heading.className = "audit-heading";
        const title = document.createElement("h3");
        title.textContent = "Page checks";
        const issueCount = audit.checks.filter((check) => check.state === "issue").length;
        const passCount = audit.checks.filter((check) => check.state === "pass").length;
        const summary = document.createElement("p");
        summary.className = "audit-summary";
        summary.textContent = issueCount
          ? `${issueCount} issue${issueCount === 1 ? "" : "s"} · ${passCount} passed`
          : `${passCount} checks passed`;
        heading.append(title, summary);

        const checks = document.createElement("ul");
        checks.className = "audit-checks";
        for (const check of audit.checks) {
          const item = document.createElement("li");
          item.className = `audit-check ${check.state}`;
          item.textContent = `${check.name}: ${check.detail}`;
          checks.append(item);
        }

        const metadata = document.createElement("details");
        metadata.className = "audit-metadata";
        const metadataSummary = document.createElement("summary");
        metadataSummary.textContent = "Metadata";
        const metadataList = document.createElement("dl");
        metadataList.className = "metadata-list";
        for (const [label, value] of [
          ["Title", audit.metadata.title],
          ["Description", audit.metadata.description],
          ["Canonical", audit.metadata.canonical],
          ["Language", audit.metadata.lang],
          ["Robots", audit.metadata.robots || "Not set"],
        ]) {
          const term = document.createElement("dt");
          term.textContent = label;
          const definition = document.createElement("dd");
          definition.textContent = value || "Missing";
          definition.title = value || "Missing";
          metadataList.append(term, definition);
        }
        metadata.append(metadataSummary, metadataList);
        auditSection.append(heading, checks, metadata);
        return auditSection;
      }

      function render() {
        const latest = new Map<string, Metric>();
        for (const metric of readDashboardMetrics()) {
          const key = `${metric.url}:${metric.name}`;
          const previous = latest.get(key);
          if (!previous || metric.timestamp > previous.timestamp) latest.set(key, metric);
        }

        const byUrl = new Map<string, Metric[]>();
        for (const metric of latest.values()) {
          byUrl.set(metric.url, [...(byUrl.get(metric.url) ?? []), metric]);
        }

        const latestAudits = new Map<string, PageAudit>();
        for (const audit of readDashboardPageAudits()) {
          const previous = latestAudits.get(audit.url);
          if (!previous || audit.timestamp > previous.timestamp) latestAudits.set(audit.url, audit);
        }

        const allMetrics = [...latest.values()];
        const newest = allMetrics.reduce<Metric | undefined>(
          (current, metric) => (!current || metric.timestamp > current.timestamp ? metric : current),
          undefined,
        );
        const auditIssues = [...latestAudits.values()].reduce(
          (total, audit) => total + audit.checks.filter((check) => check.state === "issue").length,
          0,
        );
        summary.textContent = allMetrics.length
          ? `${byUrl.size} page${byUrl.size === 1 ? "" : "s"} · ${allMetrics.length} latest metrics · ${auditIssues} page issue${auditIssues === 1 ? "" : "s"} · updated ${new Date(newest!.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`
          : "No local data yet";

        content.replaceChildren();
        if (byUrl.size === 0) {
          const empty = document.createElement("p");
          empty.className = "empty";
          empty.textContent = "No local RUM measurements yet. Visit a page that enables WebVitals with dashboard={true}, then return here.";
          content.append(empty);
          return;
        }

        const routes = document.createElement("div");
        routes.className = "route-list";
        for (const [url, metrics] of [...byUrl].sort(([, a], [, b]) => b[0].timestamp - a[0].timestamp)) {
          const section = document.createElement("section");
          section.className = "route";
          const header = document.createElement("div");
          header.className = "route-header";
          const heading = document.createElement("h2");
          heading.textContent = url;
          const count = document.createElement("span");
          count.className = "route-count";
          count.textContent = `${metrics.length} metric${metrics.length === 1 ? "" : "s"}`;
          header.append(heading, count);

          const list = document.createElement("ul");
          list.className = "metrics";
          for (const metric of metrics.sort((a, b) => a.name.localeCompare(b.name))) {
            const item = document.createElement("li");
            item.className = "metric";
            const name = document.createElement("span");
            name.className = "metric-name";
            name.textContent = metric.name;
            const value = document.createElement("strong");
            value.className = "metric-value";
            value.textContent = formatMetric(metric);
            const footer = document.createElement("div");
            footer.className = "metric-footer";
            const rating = document.createElement("span");
            rating.className = `rating${metric.rating ? ` ${metric.rating}` : ""}`;
            rating.textContent = metric.rating ?? "observed";
            const captured = document.createElement("time");
            captured.dateTime = new Date(metric.timestamp).toISOString();
            captured.textContent = new Date(metric.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
            footer.append(rating, captured);
            item.append(name, value, footer);
            list.append(item);
          }
          const audit = latestAudits.get(url);
          section.append(header, list);
          if (audit) section.append(renderPageAudit(audit));
          routes.append(section);
        }
        content.append(routes);
      }

      clear.addEventListener("click", () => {
        clearDashboardMetrics();
        render();
      });

      sitemapPass.addEventListener("click", async () => {
        sitemapPass.disabled = true;
        passNote.textContent = "Reading sitemap…";
        try {
          const response = await fetch("/sitemap.xml", { cache: "no-store" });
          if (!response.ok) throw new Error(`Sitemap returned ${response.status}`);
          const xml = await response.text();
          const urls = [...xml.matchAll(/<loc>([^<]+)<\/loc>/g)]
            .map((match) => new URL(match[1].trim()))
            .map((url) =>
              new URL(`${url.pathname}${url.search}`, window.location.origin).href,
            )
            .filter((url) => url !== window.location.href);
          if (!startSitemapPass(urls, window.location.href)) {
            throw new Error("The sitemap contains no pages to measure");
          }
          window.location.assign(urls[0]);
        } catch (error) {
          passNote.textContent = error instanceof Error ? error.message : "Could not start the sitemap pass";
          sitemapPass.disabled = false;
        }
      });
      render();
    </script>
  </body>
</html>
